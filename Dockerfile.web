# Web dashboard service (Railway). The bot runs from the default `Dockerfile`.
# Point the Railway web service's "Dockerfile Path" at this file.
FROM node:22-slim
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile && pnpm build && pnpm prune --prod
# Production web server; listens on Railway's injected $PORT.
CMD ["node", "apps/web/dist/server/index.js"]
