DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild for instant dev iteration
DISCORD_GUILD_ID=
MONGODB_URI=
# Groq/Gemini power the TEXT features: /ask, /summarize, ai_reply flow actions
# and the voice intent classifier (plus the free-form fallback when the
# realtime session is down).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# OpenAI powers the VOICE pipeline: Realtime speech-to-speech conversation,
# per-utterance transcription (feeds profanity moderation) and verbatim TTS.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ElevenLabs: per-DIALECT Arabic voices for the LIVE assistant (Arabic guilds
# only). OpenAI Realtime stays the STT/LLM/VAD brain and emits TEXT; ElevenLabs
# speaks it in the guild's chosen dialect. Leave the key empty to keep the
# OpenAI Realtime voice everywhere. A dialect with no voice id below falls back
# to the OpenAI voice too — set the ids for the dialects you offer.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_MSA=
ELEVENLABS_VOICE_GULF=
ELEVENLABS_VOICE_EGYPTIAN=
ELEVENLABS_VOICE_LEVANTINE=
# Set to true only if you enable text protection AND turned on the Message Content Intent
# in the Discord Developer Portal — otherwise leave empty (default deploy needs neither).
ENABLE_TEXT_PROTECTION=
# Set to true to enable the /summarize (Catch me up) command. Like text protection
# it needs the Message Content Intent turned on in the Discord Developer Portal.
ENABLE_SUMMARY=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
# Comma-separated Discord user ids allowed into the owner/super-admin panel (/admin).
SUPER_ADMIN_IDS=
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# Optional: Discord webhook URL that receives bot offline/recovery alerts from the dashboard server
ALERT_WEBHOOK_URL=
