# it needs the Message Content Intent turned on in the Discord Developer Portal.
ENABLE_SUMMARY=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# Optional: Discord webhook URL that receives bot offline/recovery alerts from the dashboard server
ALERT_WEBHOOK_URL=
