DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild for instant dev iteration
DISCORD_GUILD_ID=
MONGODB_URI=
# Groq/Gemini power the TEXT features: /ask, /summarize, ai_reply flow actions
# and the voice intent classifier (plus the free-form fallback when the
# realtime session is down).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Groq Whisper — only used when VOICE_STT=groq (see below).
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
# Voice engine for the live assistant:
#   groq (DEFAULT) — Groq Whisper (STT) + Groq Llama (answer) + ElevenLabs
#     (voice). NO OpenAI. Cheapest; needs GROQ_API_KEY + ElevenLabs below.
#   openai — OpenAI Realtime speech-to-speech (needs OpenAI credit).
VOICE_ENGINE=groq
# Transcription provider, independent of the engine:
#   elevenlabs (DEFAULT for VOICE_ENGINE=groq) — Scribe. Best Arabic, biases on
#     the wake word via keyterms, $0.22/h, uses ELEVENLABS_API_KEY.
#   groq — Whisper, $0.04/h, but needs the model enabled in the Groq project.
#   openai — gpt-4o-*-transcribe.
# Empty follows VOICE_ENGINE (groq → elevenlabs, openai → openai).
VOICE_STT=
# OpenAI is only used when VOICE_ENGINE=openai (Realtime + per-utterance
# transcription + verbatim TTS). Leave empty for the groq engine.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ElevenLabs voices. With VOICE_ENGINE=groq this is the bot's ONLY voice, for
# ALL languages: DEFAULT is used for every non-Arabic language and as the
# fallback for Arabic dialects with no dedicated voice id. Arabic guilds pick a
# dialect in the dashboard → its voice id below (falls back to DEFAULT).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Scribe model for VOICE_STT=elevenlabs.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_VOICE_DEFAULT=
ELEVENLABS_VOICE_MSA=
ELEVENLABS_VOICE_GULF=
ELEVENLABS_VOICE_EGYPTIAN=
ELEVENLABS_VOICE_LEVANTINE=
# Set to true only if you enable text protection AND turned on the Message Content Intent
# in the Discord Developer Portal — otherwise leave empty (default deploy needs neither).
ENABLE_TEXT_PROTECTION=
# Set to true to enable the /summarize (Catch me up) command. Like text protection
# it needs the Message Content Intent turned on in the Discord Developer Portal.
ENABLE_SUMMARY=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
# Comma-separated Discord user ids allowed into the owner/super-admin panel (/admin).
SUPER_ADMIN_IDS=
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# Optional: Discord webhook URL that receives bot offline/recovery alerts from the dashboard server
ALERT_WEBHOOK_URL=
