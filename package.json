{
  "name": "gamebot",
  "private": true,
  "engines": { "node": ">=22.12" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @gamebot/bot dev",
    "dev:web": "pnpm --filter @gamebot/web dev",
    "deploy:commands": "pnpm --filter @gamebot/bot deploy:commands",
    "backup": "pnpm --filter @gamebot/db backup",
    "restore": "pnpm --filter @gamebot/db restore"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
